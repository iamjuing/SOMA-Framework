{
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#ffc861",
    },

    "editor.detectIndentation": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "[cpp]": {
        "editor.defaultFormatter": "ajkhoury.uncrustify-format"
    },
    "[c]": {
        "editor.defaultFormatter": "ajkhoury.uncrustify-format"
    },

    "search.exclude": {
        "build": true,
    },

    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "build": true,
    },
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autoAddFileAssociations": false,

    "cmake.configureOnOpen": false,

    "uncrustify-format.configPath.windows": "${workspaceFolder}/dev/uncrustify.cfg",
    "uncrustify-format.configPath.osx": "${workspaceFolder}/dev/uncrustify.cfg",
    "uncrustify-format.configPath.linux": "${workspaceFolder}/dev/uncrustify.cfg",
}
